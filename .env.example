# Copy to .env and fill in. Values are validated at build and dev startup by
# src/shared/config/env/server.env.ts. CI reads the same names from GitHub
# repo secrets (.github/workflows/nextjs.yml).

# Required: Notion internal integration secret, used to fetch posts.
# Notion -> Settings -> Connections -> Develop or manage integrations.
# Share the posts database with the integration, or the query fails with object_not_found.
NOTION_API_KEY=notion_apiKey

# Required: ID of the Notion data source (the posts database) to query.
# Open the database, then its "..." menu -> Manage data sources -> Copy data source ID.
NOTION_DATASOURCE_ID=notion-datasource-id

# Optional: Cloudflare Web Analytics site token.
# Cloudflare dashboard -> Web Analytics -> Add a site -> copy "token" from the JS snippet.
# The beacon is added only to production builds (`npm run build`), never `next dev`.
# Leave empty to build without analytics.
CF_BEACON_TOKEN=
