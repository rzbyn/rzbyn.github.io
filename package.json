{
  "name": "rzbyn.com",
  "version": "0.3.1",
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack",
    "prebuild": "node -e \"require('node:fs').rmSync('public/notion',{recursive:true,force:true})\"",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "lint:fix": "eslint --fix",
    "format:check": "prettier --check \"src/**/*.{ts,tsx}\"",
    "format": "prettier --write \"src/**/*.{ts,tsx}\"",
    "test": "node --test \"src/**/*.test.ts\""
  },
  "dependencies": {
    "@notionhq/client": "^5.31.1",
    "@t3-oss/env-nextjs": "^0.13.11",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "next": "^16.4.6",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "sharp": "0.35.5",
    "tailwind-merge": "^3.7.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.7",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^26",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^10",
    "eslint-config-next": "^16.4.6",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.10.1",
    "tailwindcss": "^4",
    "typescript": "^6"
  },
  "overrides": {
    "source-map-js": "1.2.4",
    "minimatch": "11.0.9"
  },
  "engines": {
    "node": ">=20.9.0 <=26.13.1",
    "npm": ">=10.1.0 <=11.20.0"
  },
  "volta": {
    "node": "26.13.1",
    "npm": "11.20.0"
  },
  "allowScripts": {
    "unrs-resolver@1.12.2": true
  }
}
